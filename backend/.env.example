# ---- General -------------------------------------------------------------
ENVIRONMENT=development            # set to "production" on your server
PROJECT_NAME=NEON//CORE
# Long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of frontend URLs allowed to call the API
FRONTEND_ORIGINS=http://localhost:5173

# ---- MongoDB -------------------------------------------------------------
# Local:  mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=neon_core
# Delete activity-log entries older than this many days (0 = keep forever)
LOG_RETENTION_DAYS=90

# ---- AI (OpenRouter) -----------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_COOLDOWN_SECONDS=10

# ---- First admin account (created on startup if it doesn't exist) -------
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
